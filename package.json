{
  "name": "invitaciones-digitales",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "npm run check",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "tsx scripts/check.ts",
    "nueva": "tsx scripts/new-invitation.ts",
    "test": "tsx --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build:offline && npm run test:e2e && npm run test:cliente",
    "placeholders": "tsx scripts/placeholders.ts",
    "optimize-images": "node scripts/optimize-images.mjs",
    "build:offline": "node scripts/build-offline.mjs",
    "test:cliente": "tsx scripts/test-cliente.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
